.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.ruff_cache/
.mypy_cache/
.pyright/
data/*
!data/.gitkeep
generations/*
!generations/.gitkeep
workspace/*
!workspace/.gitkeep
evomesh.yaml
evomesh.secrets.yaml
.env
desktop/**/bin/
desktop/**/obj/
desktop/**/.vs/
.runtime/
build/
dist/
temp/
tmp/
.temp/
.tmp/

# A watcher's own remembered state (equity highs, already-reported links) --
# runtime state like data/ or workspace/, not source.
**/.watch_state.json

# news_fetch's own durable headline cache -- runtime state, rebuilt from live
# feeds, not source.
**/.news_cache.jsonl

# Per-candidate scratch: the objective lives in the commit message, and a
# validation record belongs to the generation that produced it.
MUTATION_OBJECTIVE.md
validation-result*.json

# Build briefs for work in progress. Local to the maintainer's checkout: a brief
# is an argument in progress, and the decisions it settles land in CLAUDE.md and
# docs/evolution/ where a reader was going to look anyway.
plans/
