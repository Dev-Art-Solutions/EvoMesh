# Real API keys, named by a ref instead of pasted straight into evomesh.yaml.
#
# This file is gitignored (see .gitignore) -- evomesh.secrets.yaml.example is
# the only version tracked in git, and it never holds a real key. Copy it to
# evomesh.secrets.yaml (untracked) and fill in real values there.
#
# A flat mapping of ref name -> the literal key string. Any name works; it
# only has to match the `api_key_ref` you give a provider in evomesh.yaml.
# One provider can have more than one key on hand by giving each its own ref
# and pointing a different `models.providers.<name>` block at each -- see
# evomesh.yaml.example's openai/openrouter/gemini entries.
#
# openai_primary: sk-...
# openai_backup: sk-...
# anthropic_main: sk-ant-...
# openrouter_key: sk-or-...
