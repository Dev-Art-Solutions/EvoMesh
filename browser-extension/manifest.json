{
  "manifest_version": 3,
  "name": "EvoMesh Browser Bridge",
  "version": "2.0.1",
  "description": "Lets EvoMesh agents read and drive Chrome tabs through a local native-messaging host you run yourself. Nothing leaves your machine.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
