environment_name: local
data_path: data/evomesh.db
generation_path: generations
# Per-agent memory.md and context.md live here, plus the shared world context.md.
workspace_path: workspace
log_level: INFO

runtime:
  # How often every agent runs one perceive -> deliberate -> act -> reflect cycle.
  cycle_seconds: 60
  # Delay between each agent's first cycle, so a boot does not stampede one model.
  stagger_seconds: 1.5
  # Prompt budgets in characters, sized for small local models. Raise these if
  # your models have a large context window; lowering them keeps a 4k-token
  # model from silently truncating an agent's memory.
  prompt_chars: 6000
  memory_chars: 3000
  context_chars: 1500
  inbox_chars: 1000

evolution:
  # The Environment Evolver opens a candidate generation on its first cycle.
  autonomous: true
  cycle_seconds: 300
  # Run uv sync / ruff / pyright / pytest on each candidate. Turn off if you do
  # not want the mesh spending minutes of CPU on validation.
  auto_validate: true
  # When validation fails, how many times the Evolver may fix its own candidate
  # before handing the failure to you. It tries ruff's own autofix first and only
  # spends a model call on what survives it. 0 reports the first failure as final.
  max_repairs: 2
  # Decide each candidate from its verdict instead of parking on you: promote
  # what validated, discard what did not, then start the next pass. A run with
  # no verdict -- auto_validate off, or this machine blocking the suite -- still
  # stops and waits for a human. Promotion moves supervisor metadata; it does
  # not swap the code the running mesh executes.
  auto_promote: false
  # A landed generation is code this process is not running. Restart into it
  # rather than leaving a human to notice the flag and do it by hand. The
  # Control Center and start-evomesh-console.bat both bring the mesh back up.
  auto_restart: true
  # Breathing room before the shutdown, so the cycle that promoted the
  # generation finishes writing its summary to every channel first.
  restart_delay_seconds: 5
  # A validation run that outruns this is stopped and reported as blocked
  # rather than failed: the candidate never got a verdict, and a suite this
  # machine could not finish is not the candidate's fault. The suite runs off
  # the agent's cycle, so the Evolver keeps answering while it works.
  validate_seconds: 1800
  # Draft a plan for the objective, have it reviewed, and recursively split it
  # into minimal work items before authoring anything -- instead of asking the
  # harness for one mutation directly. No revision or depth limit: the model
  # alone decides when a draft is approved and when an item is minimal, so a
  # generation with this on can take a lot longer than one without it.
  auto_plan: false
  # Optional starting objective. Otherwise use: /evolution start <objective>
  objective: null

# A model that can look at the project before it answers, instead of being handed
# one prompt and asked to guess. Off by default. Its tools read, search and list;
# with allow_write on they also edit and create, inside the job root and no further.
#
# harness:
#   enabled: false
#   # Whether any harness job may change a file. Separate from enabled on
#   # purpose: edit and write are confined to the job root, but the job root
#   # for a console run is your checkout.
#   allow_write: false
#   # One step is one model turn, which may ask for several tools at once. The
#   # caps are what turn a model that keeps asking for one more file into a job
#   # that ends and says why.
#   max_steps: 24
#   max_seconds: 300
#   # What the model may be sent in one turn. Over this, the oldest tool results
#   # are dropped with a marker saying so -- because the alternative is the model
#   # server dropping the oldest end of the prompt, where the objective lives.
#   transcript_chars: 12000
#   # Programs the harness may run, by bare name. Empty -- the default -- means
#   # the shell tool is not offered at all. There is no shell interpreter, so
#   # pipes and redirects are arguments rather than operators, and this is an
#   # allow-list because a deny-list is a promise nobody can keep.
#   shell_allow: []          # e.g. [python, git, ruff]
#   shell_seconds: 60
#   # How much of a file may enter the transcript. The tool truncates and says
#   # what it withheld, so the model can ask for the rest -- rather than the
#   # model server silently dropping the oldest end of the prompt.
#   tool_result_chars: 4000
#   tool_result_lines: 200
#   grep_matches: 40
#   # One JSONL file per job, written as it runs.
#   session_path: .runtime/harness
#   # One tool loop at a time. Two on one card do not go twice as fast -- they
#   # queue inside the GPU instead of in a queue you can look at.
#   workers: 1
#   max_queue: 8

# The Web.Fetch skill and the harness's fetch tool: an agent asks for a URL,
# gets back its main content as Markdown. Off by default. Scrapling
# (github.com/D4Vinci/Scrapling) is not a runtime dependency of this project --
# its fetchers extra alone pulls in a dozen packages, a browser automation
# stack among them, and rule 16 in CLAUDE.md keeps this project's own list at
# five. Run scripts/install-scrapling.ps1 / .sh once to provision it into its
# own venv under .runtime/, then point executable at the scrapling binary that
# produces. Add -WithBrowser / --with-browser to also pull down Chromium (a
# few hundred MB, one time) so the fetch tool's dynamic: true argument works,
# for a page whose content JavaScript builds client-side; without it, static
# HTTP fetching alone already works.
#
# scraping:
#   enabled: false
#   executable: ""
#   # Passed to scrapling as --timeout; a hung fetch should not hang the agent.
#   timeout_seconds: 30
#   # A fetched page can be any size, and it is about to sit in a model's
#   # prompt -- same character-budget discipline as everything else here
#   # (rule 3). The trim is ours, and the skill says what it withheld.
#   max_content_chars: 20000

system_agents:
  architect:
    provider: ollama
    model: qwen3
  guardian:
    provider: ollama
    model: qwen3
  evaluator:
    provider: ollama
    model: qwen3
  evolver:
    provider: ollama
    model: qwen3
    # Any of the four may override the provider's num_ctx (below) for just
    # this agent -- the Evolver's harness turns are the biggest prompts this
    # project sends, so it is the one most likely to need its own number.
    # Omit to inherit models.providers.<provider>.num_ctx like the other three.
    # num_ctx: 65536

models:
  default_provider: ollama
  providers:
    ollama:
      base_url: http://127.0.0.1:11434
      model: qwen3
      # Seconds to wait for one answer. A 30B model on a busy GPU needs minutes.
      timeout_seconds: 600
      # Sent as `options.num_ctx` on every request. Ollama's own default is
      # 2048 tokens no matter how large the model was trained for, and every
      # character budget in this file (runtime.*_chars, harness.transcript_chars)
      # assumes the server actually has room for what gets sent -- unset, the
      # server truncates the prompt from the oldest end itself, silently, before
      # this project's own budgeting ever runs. 64k is a comfortable default for
      # anything from a small chat model up to the 30-35B class this project
      # targets; raise it if VRAM allows a bigger window, lower it if a smaller
      # model or a tighter card needs the memory back. Leave it unset only for a
      # server with no such option (OpenAI-compatible providers ignore this
      # field). Overridable per model below, and per agent in system_agents
      # above -- checked in that order: agent, then model, then this default.
      num_ctx: 65536
      # model_num_ctx:
      #   some-other-model-on-this-server: 8192
    inferhub:
      base_url: http://127.0.0.1:5080/v1
      model: qwen3
    openai_compatible:
      base_url: http://127.0.0.1:8000/v1
      model: local-model
      api_key: ""

git:
  # Every generation the mesh commits is signed with this identity, so a human
  # reading the history can tell the agent's work from their own at a glance.
  author_name: Mesh Evo Agent
  author_email: mesh-evo-agent@evomesh.local
  # Push a landed generation to the remote. A push that fails never undoes the
  # commit -- the generation is in the tree either way, only unpublished -- and
  # the reason is reported by /evolution status.
  auto_push: true
  remote: origin
  # Empty means whatever branch the checkout is already on.
  branch: ""

telegram:
  # Talk to the mesh from your phone. Everything you send goes through the same
  # command router the Control Center uses, so /status, /agents and /evolution
  # all work exactly as they do on the desktop.
  enabled: false
  # The token BotFather gives you when you create the bot.
  token: ""
  # Chats allowed to talk to the mesh. Leave empty and keep adopt_first_chat on:
  # the first person who sends /start claims the bot, and the id is remembered.
  allowed_chat_ids: []
  adopt_first_chat: true
  poll_timeout_seconds: 30
  # Say when a generation lands or the mesh restarts, not only when asked.
  announcements: true
